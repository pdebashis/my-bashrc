#--- [ UNIX COMMANDS ] -------------------------
alias xxtree="find . -print | sed -e 's;[^/]*/;|____;g;s;____|; |;g'"
alias xxneverhere="history -c && history -w"
alias rm='rm -vrf --preserve-root'
alias tailf='tail -f'

#-- [TELEPORT PATHS] --------------------------
alias mygit='cd /mnt/c/Users/<>/Documents/Github/'
alias myonedrive='cd '
alias mydownloads='cd /mnt/c/Users/<>/Downloads/Github/'

#--- [ DYSLEXIA ] ------------------------------
alias mdkir='mkdir'


#--- [ ENV Variables ] -------------------------
export VISUAL="vim"

